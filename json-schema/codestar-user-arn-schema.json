{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/amazon-codestar/refs/heads/main/json-schema/codestar-user-arn-schema.json",
  "title": "UserArn",
  "description": "UserArn schema from AWS CodeStar API",
  "type": "string",
  "pattern": "^arn:aws:iam::\\d{12}:user(?:(\\u002F)|(\\u002F[\\u0021-\\u007E]+\\u002F))[\\w+=,.@-]+$",
  "minLength": 32,
  "maxLength": 95
}