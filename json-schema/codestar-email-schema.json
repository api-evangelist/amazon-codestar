{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/amazon-codestar/refs/heads/main/json-schema/codestar-email-schema.json",
  "title": "Email",
  "description": "Email schema from AWS CodeStar API",
  "type": "string",
  "format": "password",
  "pattern": "^[\\w-.+]+@[\\w-.+]+$",
  "minLength": 3,
  "maxLength": 128
}